# ─── REQUIS pour Vercel ───

# ─── AI PROVIDER : "groq" (défaut), "gemini" ou "custom" ───
AI_PROVIDER=gemini

# Option 1 — GEMINI (recommandé, gratuit + généreux) :
# Clé gratuite sur https://aistudio.google.com → "Get API key"
GEMINI_API_KEY=AIza_votre_cle_ici
# Modèle (optionnel, défaut : gemini-3.6-flash)
# AI_MODEL=gemini-3.6-flash

# Option 2 — GROQ (gratuit, rapide) :
# Clé gratuite sur https://console.groq.com
# GROQ_API_KEY=gsk_votre_cle_ici
# Modèle (optionnel, défaut : openai/gpt-oss-20b — rapide et gratuit)
# AI_MODEL=openai/gpt-oss-20b

# Option 3 — CUSTOM (n'importe quel endpoint compatible OpenAI : OpenRouter, Together…)
# AI_PROVIDER=custom
# AI_API_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-votre_cle_ici
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Mot de passe UNIQUE d'accès — l'admin l'envoie aux candidats
# (si absent, valeur par défaut : CPU_MEMBER_2026)
MEMBER_PASSWORD=CPU_MEMBER_2026

# ─── EMAIL AUTOMATIQUE (rapport envoyé à la fin de chaque entretien) ───
# Gratuit via Gmail : activez la validation en 2 étapes, puis créez un
# "mot de passe d'application" sur https://myaccount.google.com/apppasswords
# SMTP_USER=votre.email@gmail.com
# SMTP_PASS=xxxx_xxxx_xxxx_xxxx (16 caractères, sans espaces)
# Destinataires (optionnel — défaut : mohamedamine.may, farah.benammar, soulayma.afrit @edu.isetcom.tn)
# REPORT_EMAILS=mohamedamine.may@edu.isetcom.tn,farah.benammar@edu.isetcom.tn,soulayma.afrit@edu.isetcom.tn

# Supabase (optionnel — pour sauvegarder les entretiens)
# SUPABASE_URL=https://votre-projet.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_ici
