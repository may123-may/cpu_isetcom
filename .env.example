# ─── REQUIS pour Vercel ───

# ─── MULTI-CANDIDATS : comment tenir à N entretiens simultanés ───
# 1) Mettez 2-3 clés Groq séparées par des virgules (3 comptes gratuits = 3x le quota).
#    Créez-les sur https://console.groq.com avec 2-3 comptes Google différents.
#    GROQ_API_KEYS=gsk_clé1,gsk_clé2,gsk_clé3
#    (GROQ_API_KEY au singulier reste supporté pour compatibilité)
# 2) Ajoutez UNE clé Gemini en SECOURS (fallback auto si Groq dit 429) :
#    Gratuite sur https://aistudio.google.com → "Get API key"
#    GEMINI_API_KEY=AIza_votre_cle_ici
# 3) Réglages anti-limite (optionnels, défauts déjà bons) :
#    AI_MIN_INTERVAL_MS=400  -> espace les appels de 400ms (lisse les rafales)
#    AI_MAX_RETRIES=2        -> réessaie 2x chaque clé avant de passer à la suivante
#    AI_DETECT_ENABLED=false -> détection AI locale (0 quota). true = ancienne version par IA.

# ─── AI PROVIDER : "groq" (défaut), "gemini" ou "custom" ───
AI_PROVIDER=groq

# Option 1 — GROQ (gratuit, rapide) :
# Clé gratuite sur https://console.groq.com
# GROQ_API_KEYS=gsk_clé1,gsk_clé2,gsk_clé3
# Modèle (optionnel, défaut : openai/gpt-oss-20b — rapide et gratuit)
# AI_MODEL=openai/gpt-oss-20b

# Option 2 — GEMINI (se cours généreux, idéal en fallback) :
# Clé gratuite sur https://aistudio.google.com → "Get API key"
# GEMINI_API_KEY=AIza_votre_cle_ici
# Modèle (défaut : gemini-3.6-flash — obligatoire sur les comptes récents, 2.5/2.0 = 404)
# GEMINI_MODEL=gemini-3.6-flash

# Option 3 — CUSTOM (n'importe quel endpoint compatible OpenAI : OpenRouter, Together…)
# AI_PROVIDER=custom
# AI_API_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-votre_cle_ici
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Mot de passe UNIQUE d'accès — l'admin l'envoie aux candidats
# (si absent, valeur par défaut : CPU_MEMBER_2026)
MEMBER_PASSWORD=CPU_MEMBER_2026

# ─── EMAIL AUTOMATIQUE (rapport envoyé à la fin de chaque entretien) ───
# Gratuit via Gmail : activez la validation en 2 étapes, puis créez un
# "mot de passe d'application" sur https://myaccount.google.com/apppasswords
# SMTP_USER=votre.email@gmail.com
# SMTP_PASS=xxxx_xxxx_xxxx_xxxx (16 caractères, sans espaces)
# Destinataires (optionnel — défaut : benammarfarah7@gmail.com, soulayma.afrit@edu.isetcom.tn)
# REPORT_EMAILS=benammarfarah7@gmail.com,soulayma.afrit@edu.isetcom.tn

# Supabase (optionnel — pour sauvegarder les entretiens)
# SUPABASE_URL=https://votre-projet.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_ici
